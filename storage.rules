rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /post-images/{fileName} {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.size <= 5242880
        && request.resource.contentType.matches('^image/(jpeg|png|webp|gif)$');
    }
  }
}